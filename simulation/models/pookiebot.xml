<mujoco model="pookiebot">
  <compiler angle="degree" coordinate="local" meshdir="assets"/>
  <option gravity="0 0 -9.81" timestep="0.005" integrator="implicitfast" cone="elliptic"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <default>
    <geom solref="0.01 1" solimp="0.9 0.95 0.001 0.5 2"/>
    <default class="chassis_visual">
      <geom type="box" contype="0" conaffinity="0" group="2" material="chassis_mat" mass="0.05"/>
    </default>
    <default class="chassis_collision">
      <geom type="box" contype="1" conaffinity="1" group="0" friction="0.5 0.005 0.0001" mass="0.2"/>
    </default>
    <default class="wheel_geom">
      <geom type="cylinder" size="0.033 0.012" contype="1" conaffinity="1" friction="0.7 0.005 0.0001" material="wheel_mat" mass="0.04"/>
    </default>
    <default class="motor_actuator">
      <velocity kv="5" ctrlrange="-15 15" forcerange="-0.4 0.4"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.8 0.85 0.9" width="512" height="512"/>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.92 0.92 0.90" rgb2="0.78 0.78 0.75" width="512" height="512" mark="cross" markrgb="0.6 0.6 0.6"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="5 5" reflectance="0.05"/>
    
    <material name="chassis_mat" rgba="0.96 0.94 0.92 1.0" specular="0.3" shininess="0.4"/>
    <material name="accent_mat" rgba="0.30 0.75 0.82 1.0" specular="0.5" shininess="0.6"/>
    <material name="wheel_mat" rgba="0.18 0.18 0.18 1.0" specular="0.1" shininess="0.1"/>
    <material name="battery_mat" rgba="0.15 0.15 0.15 1.0"/>
    <material name="phone_body_mat" rgba="0.12 0.12 0.14 1.0" specular="0.6" shininess="0.8"/>
    <material name="phone_screen_mat" rgba="0.08 0.12 0.22 1.0" emission="0.3" specular="0.8" shininess="0.9"/>
    <material name="eye_glow_mat" rgba="0.25 0.88 0.95 1.0" emission="0.8"/>
    <material name="sensor_mat" rgba="0.2 0.2 0.2 1.0"/>
    <material name="obstacle_toy_mat" rgba="0.95 0.40 0.35 1.0" specular="0.4"/>
    <material name="obstacle_ball_mat" rgba="0.98 0.78 0.25 1.0" specular="0.5"/>
  </asset>

  <worldbody>
    <!-- Lighting -->
    <light directional="true" pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <light directional="false" pos="2 2 3" diffuse="0.4 0.4 0.4"/>

    <!-- Floor (Living room / Nursery play area) -->
    <geom name="floor" type="plane" size="10 10 0.1" material="floor_mat" contype="1" conaffinity="1"/>

    <!-- Room Boundary Walls -->
    <geom name="wall_north" type="box" pos="0 3 0.2" size="3.2 0.05 0.2" rgba="0.85 0.88 0.90 0.5" contype="1" conaffinity="1"/>
    <geom name="wall_south" type="box" pos="0 -3 0.2" size="3.2 0.05 0.2" rgba="0.85 0.88 0.90 0.5" contype="1" conaffinity="1"/>
    <geom name="wall_east" type="box" pos="3 0 0.2" size="0.05 3.0 0.2" rgba="0.85 0.88 0.90 0.5" contype="1" conaffinity="1"/>
    <geom name="wall_west" type="box" pos="-3 0 0.2" size="0.05 3.0 0.2" rgba="0.85 0.88 0.90 0.5" contype="1" conaffinity="1"/>

    <!-- Cute Obstacles (Baby soft blocks, toy ball) -->
    <!-- Soft Toy Block directly in test path at x=0.85, y=0 -->
    <body name="toy_block" pos="0.85 0.0 0.06">
      <joint type="free" damping="0.05"/>
      <geom type="box" size="0.07 0.07 0.06" material="obstacle_toy_mat" mass="0.2" contype="1" conaffinity="1"/>
    </body>

    <!-- Toy Ball at x=1.2, y=-0.5 -->
    <body name="toy_ball" pos="1.2 -0.5 0.05">
      <joint type="free" damping="0.05"/>
      <geom type="sphere" size="0.05" material="obstacle_ball_mat" mass="0.1" contype="1" conaffinity="1"/>
    </body>

    <!-- ======================================================== -->
    <!-- POOKIEBOT: MOBILE SOCIAL ROBOT EMBODIMENT                  -->
    <!-- ======================================================== -->
    <body name="pookiebot" pos="0 0 0.035">
      <freejoint name="root"/>

      <!-- Low-Mounted Heavy Battery Pack (Stabilizes Center of Gravity at bottom) -->
      <geom name="battery_ballast" type="box" size="0.06 0.04 0.008" pos="0 0 0.005" material="battery_mat" mass="0.6" contype="0" conaffinity="0"/>

      <!-- Main Chassis Body -->
      <geom name="chassis_base_vis" class="chassis_visual" size="0.10 0.060 0.015" pos="0 0 0.015"/>
      <geom name="chassis_base_col" class="chassis_collision" size="0.09 0.055 0.015" pos="0 0 0.015"/>

      <!-- Top Bumper / Cover Deck -->
      <geom name="chassis_top" class="chassis_visual" size="0.09 0.055 0.005" pos="0 0 0.035" material="accent_mat"/>

      <!-- Front Ultrasonic Sensor (HC-SR04) Eyes -->
      <geom name="sonar_body" type="box" size="0.008 0.022 0.01" pos="0.10 0 0.025" material="sensor_mat" contype="0" conaffinity="0" mass="0.01"/>
      <geom name="sonar_tx" type="cylinder" size="0.008 0.004" pos="0.108 0.011 0.025" euler="0 90 0" material="accent_mat" contype="0" conaffinity="0" mass="0.005"/>
      <geom name="sonar_rx" type="cylinder" size="0.008 0.004" pos="0.108 -0.011 0.025" euler="0 90 0" material="accent_mat" contype="0" conaffinity="0" mass="0.005"/>
      
      <!-- Forward-Facing Rangefinder Site (Ray points along site Z-axis = forward +X when euler="0 90 0") -->
      <site name="sonar_site" pos="0.112 0 0.025" euler="0 90 0" size="0.005" rgba="1 0 0 0"/>

      <!-- Forward Teleoperation Camera Site -->
      <camera name="third_person_view" pos="-0.6 0 0.4" euler="0 25 -90" mode="trackcom"/>

      <!-- ====================================================== -->
      <!-- SMARTPHONE HEAD: DOCKED AT 35-DEGREE TILT ANGLE        -->
      <!-- ====================================================== -->
      <body name="smartphone_head" pos="0.01 0 0.04" euler="0 -35 0">
        <!-- Phone Outer Shell / Case -->
        <geom name="phone_body" type="box" size="0.075 0.038 0.004" pos="0 0 0.04" material="phone_body_mat" contype="0" conaffinity="0" mass="0.12"/>

        <!-- Phone Display Screen -->
        <geom name="phone_screen" type="box" size="0.070 0.034 0.001" pos="0 0 0.044" material="phone_screen_mat" contype="0" conaffinity="0" mass="0.01"/>

        <!-- Animated Eye Geoms (Visual representation of digital face) -->
        <geom name="eye_left" type="cylinder" size="0.012 0.001" pos="0.018 0.016 0.045" euler="0 0 0" material="eye_glow_mat" contype="0" conaffinity="0" mass="0.001"/>
        <geom name="eye_right" type="cylinder" size="0.012 0.001" pos="0.018 -0.016 0.045" euler="0 0 0" material="eye_glow_mat" contype="0" conaffinity="0" mass="0.001"/>

        <!-- Robot Forward Vision Camera (Rear-Facing Lens of Phone) -->
        <camera name="robot_eye_camera" pos="-0.006 0 0.07" euler="0 -55 180" fovy="65"/>
      </body>

      <!-- ====================================================== -->
      <!-- WHEELS & DIFFERENTIAL ACTUATION (OPENBOT 4WD)          -->
      <!-- ====================================================== -->
      <!-- Front-Left Wheel -->
      <body name="wheel_fl" pos="0.065 0.075 0">
        <joint name="wheel_fl_joint" type="hinge" axis="0 1 0" damping="0.02" armature="0.001"/>
        <geom name="wheel_fl_geom" class="wheel_geom" euler="90 0 0"/>
      </body>

      <!-- Rear-Left Wheel -->
      <body name="wheel_rl" pos="-0.065 0.075 0">
        <joint name="wheel_rl_joint" type="hinge" axis="0 1 0" damping="0.02" armature="0.001"/>
        <geom name="wheel_rl_geom" class="wheel_geom" euler="90 0 0"/>
      </body>

      <!-- Front-Right Wheel -->
      <body name="wheel_fr" pos="0.065 -0.075 0">
        <joint name="wheel_fr_joint" type="hinge" axis="0 1 0" damping="0.02" armature="0.001"/>
        <geom name="wheel_fr_geom" class="wheel_geom" euler="90 0 0"/>
      </body>

      <!-- Rear-Right Wheel -->
      <body name="wheel_rr" pos="-0.065 -0.075 0">
        <joint name="wheel_rr_joint" type="hinge" axis="0 1 0" damping="0.02" armature="0.001"/>
        <geom name="wheel_rr_geom" class="wheel_geom" euler="90 0 0"/>
      </body>
    </body>
  </worldbody>

  <!-- ======================================================== -->
  <!-- SENSORS                                                  -->
  <!-- ======================================================== -->
  <sensor>
    <rangefinder name="ultrasonic_sonar" site="sonar_site"/>
  </sensor>

  <!-- ======================================================== -->
  <!-- ACTUATORS: LEFT & RIGHT CHANNELS (OPENBOT PWM BRIDGE)    -->
  <!-- ======================================================== -->
  <actuator>
    <velocity name="act_fl" joint="wheel_fl_joint" class="motor_actuator"/>
    <velocity name="act_rl" joint="wheel_rl_joint" class="motor_actuator"/>
    <velocity name="act_fr" joint="wheel_fr_joint" class="motor_actuator"/>
    <velocity name="act_rr" joint="wheel_rr_joint" class="motor_actuator"/>
  </actuator>
</mujoco>
